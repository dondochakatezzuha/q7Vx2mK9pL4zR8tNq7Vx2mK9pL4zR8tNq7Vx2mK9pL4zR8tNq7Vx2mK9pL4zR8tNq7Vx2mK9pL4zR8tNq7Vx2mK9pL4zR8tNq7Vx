          },
          {
            "message_id": 1540971338343391312,
            "channel_id": 1535189087760154667,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Eye : A powerful beast of a monster who has the abilitites to create vines out of his body duplicate himself but is limited by the eye if stabbed he becomes weaker and if completly removed he dies BUT, his eye is also his strongest trait as it shoots plasma beam**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087760154667/1540971337894596698/content.png?ex=6a8be4e4&is=6a8a9364&hm=8261320a6da2764ce5b435ca07bb0be362644af8e9864c60828c268d988c2142&",
