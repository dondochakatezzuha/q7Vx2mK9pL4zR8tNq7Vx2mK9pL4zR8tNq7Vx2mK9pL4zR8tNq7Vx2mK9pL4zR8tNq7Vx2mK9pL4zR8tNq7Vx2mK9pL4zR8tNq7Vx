          {
            "message_id": 1540969548121907270,
            "channel_id": 1535189087760154667,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Stone : A Giant of a monster with no special abilities but immense physical strength being able to wipe out literal kingdoms but a width of his fingertip, has short amount of stamin and is slower than the rest of his team but when he enters his mode \"Carnage\" his golden like tattoos glow red enhancing his already enhanced physical strengths by 50**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087760154667/1540969547748745288/content.png?ex=6a8be33a&is=6a8a91ba&hm=9bd20c06f66929a135a8110b5e235e67cdb88c2af5c0f25b197e7230427144a0&",
