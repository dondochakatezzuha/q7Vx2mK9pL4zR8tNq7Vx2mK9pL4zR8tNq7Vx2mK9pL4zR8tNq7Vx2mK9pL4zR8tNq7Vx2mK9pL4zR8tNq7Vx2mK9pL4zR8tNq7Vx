            "message_id": 1535419256618090588,
            "channel_id": 1535196024619139082,
            "guild_id": 1535189086258855946,
            "author_id": 1187513925739237408,
            "author_name": "civic",
            "content": "**Rule 1: don't argue with other members over in-game decisions ESPECIALLY from the last game TWN, any personal issues can be resolved in DMs not here**\n**Rule 2: don't post NSFW or straight nude characters, atleast some clothes should be on**\n**Rule 3: If i see a single mrbeast giving money image its a ban, same for any other scam links**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535196024619139082/1535419256618090588",
            "created_at": "2026-08-07T22:47:57.488000+00:00"
