          {
            "message_id": 1538168213714767932,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Welcome, Yellow hero's, three of you made it this far, I am uncle Raja, I'm blind, you are probably wondering how i could tell there was only three of you? well it's because someone told me HAHA! okay you don't joke around, this mansion is owned by my family, they created security services to help children like you learn how to use their abilities, I want you three to choose a companion, yes. A pet, but before I reveal what type they are, please make yourself comofortable**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087282008118/1538168213098078208/content.png?ex=6a864f87&is=6a84fe07&hm=1e89b7c80a373d1114e9d49e35ce6bb9a7c216e139eefd675d87bf86d68d8b9b&",
                "content_type": "image/png",
                "size": 2651015
              }
            ],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1538168213714767932",
            "created_at": "2026-08-15T12:51:19.933000+00:00"
          },
          {
            "message_id": 1538168623749795900,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Raja hit his cane on your head,\" I wasn't always blind young lad, Vespa took it from me on a night he murdered my entire family, my daughter's, my wife, and my son's ceased to exist for merely being related to me.**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1538168623749795900",
            "created_at": "2026-08-15T12:52:57.693000+00:00"
          },
          {
            "message_id": 1538168979221258280,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**The previous have said the same, all I've received from them was their body and the funeral's I had to attend.**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1538168979221258280",
            "created_at": "2026-08-15T12:54:22.444000+00:00"
          },
