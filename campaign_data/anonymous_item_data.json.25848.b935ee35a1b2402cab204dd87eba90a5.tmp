          },
          {
            "message_id": 1540687207046578217,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**The boat finds an island not far away from mariam's one it seems to look deserted**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540687207046578217",
            "created_at": "2026-08-22T11:40:54.744000+00:00"
          },
          {
            "message_id": 1540687494394286081,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick : there's an island where no one knows and only I know, I can help save your friends please take me there it's near Infernia and mystia, it's under water It's safe**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540687494394286081",
            "created_at": "2026-08-22T11:42:03.253000+00:00"
          },
          {
            "message_id": 1540687738196729936,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**you divert the ship to drive to the under-water island**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540687738196729936",
            "created_at": "2026-08-22T11:43:01.380000+00:00"
          },
          {
            "message_id": 1540688105013518386,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**you've reached your destination**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540688105013518386",
            "created_at": "2026-08-22T11:44:28.836000+00:00"
          },
          {
            "message_id": 1540688227457835148,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick jumps off the ship**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540688227457835148",
            "created_at": "2026-08-22T11:44:58.029000+00:00"
          },
          {
            "message_id": 1540689633736663080,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick dives down pressing a button before diving back up, suddenly, a large Island came out of the water showing his big purple lit facility**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087282008118/1540689632633688185/content.png?ex=6a8ade89&is=6a898d09&hm=15228447369740a9dc7279faf04519adf231f33872b31db9984be04aa4363a1f&",
                "content_type": "image/png",
                "size": 2946246
              }
            ],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540689633736663080",
            "created_at": "2026-08-22T11:50:33.312000+00:00"
          },
          {
            "message_id": 1540690075476688916,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick then say's \"Violet please open the garage for our boat**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540690075476688916",
            "created_at": "2026-08-22T11:52:18.631000+00:00"
          },
          {
            "message_id": 1540690340023902229,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick entered inside his facility with the players, greeting them was Mevricks maid, Violet, She prepared some meal for Mev**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087282008118/1540690339646672916/content.png?ex=6a8adf31&is=6a898db1&hm=ba647f144825f10477e56cfb9c822d34c3bd3529670368ee3de13696600adac1&",
                "content_type": "image/png",
                "size": 2388095
              }
            ],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540690340023902229",
            "created_at": "2026-08-22T11:53:21.704000+00:00"
          },
          {
            "message_id": 1540690838294757417,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick show's the players some research he was doing, there was a yellow stone just sitting in a container in the living he explained that was the last fragment he found and is the only thing keeping him from changing inside the facility **",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540690838294757417",
            "created_at": "2026-08-22T11:55:20.501000+00:00"
          },
          {
            "message_id": 1540691496989106237,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Aro was created by the first titan Mother Prana, we call her aro itself, the fastest way a person can connect with his or her own aro is to find mother Prana, but mother prana has not been seen since 40 years ago, I've been searching for her to help me contain vespa, If I help you save your friends, will you help me find prana?**",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540691496989106237",
            "created_at": "2026-08-22T11:57:57.546000+00:00"
          },
          {
            "message_id": 1540692445925220422,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Mevrick sat in his chair thinking for a few minutes, Violet! he said, suit up and get your sister I need you two to visit the council's office while I save their friends, Yes master replied Violet.**",
            "attachments": [
              {
                "filename": "content.png",
                "url": "https://cdn.discordapp.com/attachments/1535189087282008118/1540692445455454238/content.png?ex=6a8ae127&is=6a898fa7&hm=608656d8c85b1cc6bf6dcfeafa4f5138c2fda4060f4a562b4b22d22524f67085&",
                "content_type": "image/png",
                "size": 2469511
              }
            ],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540692445925220422",
            "created_at": "2026-08-22T12:01:43.790000+00:00"
          },
          {
            "message_id": 1540693003369451600,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**Violet throws one of her cards in the air and as it fell back down she disappeared, appearing in front of Arlo and the team that was captured, three guards saw her and began shooting she evaded every bullet before throwing three knives that stabbed each guard in the neck, I'm here to get you out she said, Vespa will come soon my sister is outside with the council **",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540693003369451600",
            "created_at": "2026-08-22T12:03:56.695000+00:00"
          },
          {
            "message_id": 1540693248136446023,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
            "author_name": "Rivic",
            "content": "**their in a different Facility **",
            "attachments": [],
            "jump_url": "https://discord.com/channels/1535189086258855946/1535189087282008118/1540693248136446023",
            "created_at": "2026-08-22T12:04:55.052000+00:00"
          },
          {
            "message_id": 1540693262908653578,
            "channel_id": 1535189087282008118,
            "guild_id": 1535189086258855946,
            "author_id": 1538115083513761813,
